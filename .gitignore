# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Tooling (this project has no build step; nothing here is required to run it)
node_modules/
npm-debug.log*

# Large source media — keep originals out of git, ship the encoded versions
assets/video/*.mov
assets/video/*.mkv
assets/video/*-source.*

# Admin credentials — never commit these
content/.auth.json

# Backups and temp files the server writes next to content
content/*.bak
content/*.tmp
